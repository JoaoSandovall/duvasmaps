# Copie este arquivo para .env e preencha os valores antes de rodar
# docker-compose up. Nunca commite o .env real no git.

# --- Banco de dados ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=defina_uma_senha_forte_aqui
POSTGRES_DB=roteirizador_db

# --- Redis ---
REDIS_PASSWORD=defina_uma_senha_forte_aqui

# --- Google Maps / Places ---
GOOGLE_MAPS_API_KEY=sua_chave_do_google_aqui

# --- Autenticação (JWT) ---
# Chave usada para assinar os tokens de login. CRÍTICO: gere um valor
# longo e aleatório, nunca deixe em branco nem reaproveite de outro projeto.
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque_por_um_valor_longo_e_aleatorio

# Código de convite exigido para criar conta em /api/register. Compartilhe
# apenas com quem deve poder se cadastrar (ex: sua equipe).
# Gerar com: python -c "import secrets; print(secrets.token_hex(16))"
REGISTRATION_SECRET=troque_por_um_codigo_de_convite_aleatorio

# Username que terá acesso ao log de auditoria (/api/audit-log). Essa
# pessoa precisa se registrar em /api/register usando exatamente este nome.
ADMIN_USERNAME=admin

# --- CORS ---
# Lista de origens do frontend permitidas, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173

# --- Controle de custo (RN05) ---
MONTHLY_PAID_CALL_LIMIT=500
# Teto de resultados por busca de lugares (protege contra buscas com
# max_resultados muito alto gerando dezenas de páginas pagas de uma vez).
MAX_PLACES_RESULTS=200

# --- Limites de upload (RN09) ---
MAX_UPLOAD_SIZE_BYTES=8388608
MAX_UPLOAD_ROWS=800

# --- Proteção contra força bruta no login e cadastro ---
AUTH_FAIL_LIMIT=10
AUTH_FAIL_WINDOW_SECONDS=900
AUTH_LOCKOUT_SECONDS=900
# --- Retenção de dados (RN11 / LGPD) ---
# Após esse número de dias, o worker de retenção apaga automaticamente
# lotes de leads antigos (e os leads associados).
LEAD_RETENTION_DAYS=180

# --- Proxy HTTPS (Caddy) ---
# Em produção, coloque seu domínio real aqui (ex: api.suaempresa.com.br)
# e aponte o DNS dele para este servidor — o Caddy emite o certificado
# HTTPS automaticamente. Em desenvolvimento local, pode deixar "localhost".
DOMAIN=localhost